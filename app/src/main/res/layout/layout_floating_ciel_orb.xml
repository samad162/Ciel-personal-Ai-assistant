<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/floatingRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:padding="8dp">

    <!-- The Little Circle Orb Container (68dp x 68dp touch zone) -->
    <FrameLayout
        android:id="@+id/orbContainer"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Outer Holographic Sonic Shockwave / Ripple Ring 1 -->
        <View
            android:id="@+id/rippleRing1"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_ciel_sonic_ripple"
            android:alpha="0" />

        <!-- Outer Holographic Sonic Shockwave / Ripple Ring 2 -->
        <View
            android:id="@+id/rippleRing2"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_ciel_sonic_ripple"
            android:alpha="0" />

        <!-- Ambient Cybernetic Glow Orb -->
        <View
            android:id="@+id/orbGlow"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_ciel_orb_glow" />

        <!-- Flawless Circular Glass Sphere with CIEL Anime Avatar -->
        <FrameLayout
            android:id="@+id/orbCoreFrame"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_ciel_orb_core"
            android:elevation="6dp">

            <!-- CIEL Anime Heroine Avatar -->
            <ImageView
                android:id="@+id/imgOrbAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ciel_avatar"
                android:contentDescription="CIEL Companion" />

            <!-- Micro Luminous Status Jewel Dot -->
            <View
                android:id="@+id/statusDot"
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="3dp"
                android:background="@drawable/bg_mic_circle" />
        </FrameLayout>
    </FrameLayout>

    <!-- Attached Dynamic Island Mini Speech Pill (Auto-Collapses, Never Covers Screen) -->
    <LinearLayout
        android:id="@+id/miniPillContainer"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:layout_toEndOf="@id/orbContainer"
        android:layout_centerVertical="true"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_ciel_mini_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:elevation="8dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/pillIcon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_ciel_sparkle"
            android:contentDescription="CIEL Sparkle"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tvPillText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="210dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Listening..."
            android:textColor="#E2E8F0"
            android:textSize="11.5sp"
            android:fontFamily="sans-serif-medium" />

        <ImageView
            android:id="@+id/btnPillDismiss"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="8dp"
            android:padding="3dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="Dismiss" />
    </LinearLayout>

</RelativeLayout>
