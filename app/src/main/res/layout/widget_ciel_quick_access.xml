<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="#121D33"
    android:padding="12dp">

    <ImageView
        android:id="@+id/widget_sparkle"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_ciel_sparkle"
        android:contentDescription="@string/app_name" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#38BDF8"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/waiting_command"
            android:textColor="#94A3B8"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_mic_button"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_mic_circle"
        android:src="@drawable/ic_mic"
        android:padding="8dp"
        android:contentDescription="@string/listening" />
</LinearLayout>
